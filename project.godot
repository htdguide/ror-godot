; Rigs of Rods on Godot - project configuration.
; Structural only. Every tunable lives in res://game/config/*.gd, never here and never in a .tscn.

config_version=5

[application]

config/name="ror-godot"
config/description="An alternative Rigs of Rods client on Godot 4.x"
run/main_scene="res://harness/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Harness="*res://harness/harness.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/return_value_discarded=0

[rendering]

renderer/rendering_method="forward_plus"
; Lights are in real units: a directional light in lux, a lamp in lumens, and exposure from the
; camera's own aperture, shutter and ISO. Everything in game/config/render_cfg.gd that used to
; balance a sun against a sky by hand exists because this was off. See PLAN M2.
lights_and_shadows/use_physical_light_units=true
textures/default_filters/anisotropic_filtering_level=3
