# Godot
.godot/
*.translation
export_presets.cfg
.import/

# Build output. bin/ holds the built GDExtension and its .gdextension descriptor; it is at
# the repository root rather than under game/ since the PLAN 0.7 tree mirror, and it is
# rebuilt by scons rather than committed.
build/
/bin/
*.o
*.os
*.obj
*.so
*.dylib
*.dll
*.pdb
.sconsign.dblite
.scons_cache/

# Harness artifacts: disposable and bounded (see docs/guides/harness.md)
artifacts/

# Visual history: every captured frame, kept forever, never pruned. Not committed —
# thousands of full-resolution frames do not belong in the repository — but never deleted
# either, so the project's appearance over time can be reviewed locally.
history/

# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp

# Terrain3D is generated, not committed: the pin is the submodule commit in
# vendor/terrain3d and tools/build_terrain3d.sh rebuilds the addon from it. Committing the
# published release instead would mean 41 MB of binaries for platforms this project does
# not target, and the binaries would be caught by the rules above anyway, leaving a
# checkout that looks complete and does not load.
#
# At the repository root rather than under game/, because Godot requires addons/ at its
# project root and project.godot moved there with the PLAN 0.7 tree mirror.
/addons/

# Community content: vehicles under assets/mods/, terrains under assets/terrains/. Not
# committed — Rigs of Rods repository content carries varied and often unstated licensing,
# and this project has no right to redistribute it. Both are fetched or copied in locally,
# and every gate that uses one skips cleanly when it is absent.
assets/mods/
assets/terrains/

# The upstream parity oracle: Rigs of Rods' own physics, extracted from the pinned submodule
# and compiled on its own by tools/build_parity.sh. Generated, never committed, for the same
# reason the addon is — a copy in the tree could drift from the upstream it claims to be.
build/

# The mod corpus tools/fetch_corpus.sh downloads for the mod_corpus gate: archive content, not ours.
assets/corpus/

# The build profile: an untracked file that marks the production checkout (tools/prod.sh writes
# it). Dev is what a checkout is without one. See game/config/build_profile.gd.
profile.cfg

# The production build's content folders: whoever runs it puts vehicles and maps here. Only the
# notes that say so are committed.
mods/*
!mods/README.md
maps/*
!maps/README.md
